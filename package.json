{
  "name": "evolving-todo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "web:dev": "pnpm --filter @evolving-todo/web dev",
    "web:dev:agent": "pnpm --filter @evolving-todo/web dev --port 5174",
    "web:build": "pnpm --filter @evolving-todo/web build",
    "web:test": "pnpm --filter @evolving-todo/web test",
    "web:typecheck": "pnpm --filter @evolving-todo/web typecheck",
    "domain:test": "pnpm --filter @evolving-todo/domain test",
    "domain:typecheck": "pnpm --filter @evolving-todo/domain typecheck",
    "test:report": "pnpm -r --no-bail run test:report",
    "tools:test": "node --test \"scripts/*.test.mjs\" \".claude/hooks/*.test.mjs\"",
    "build:pages": "pnpm run docs:build && pnpm run web:build && node scripts/copy-web-to-pages.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "vitepress": "^1.6.4"
  }
}
